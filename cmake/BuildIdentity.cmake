# One frozen identity drives JUCE, the compiled marker and all package names.
set(_identity_variable "${PROJECT_NAME}_BUILD_NUMBER")
string(TOUPPER "${_identity_variable}" _identity_variable)
if(NOT DEFINED ${_identity_variable})
    if(DEFINED ENV{BUILD_NUMBER})
        set(_identity_default "$ENV{BUILD_NUMBER}")
    elseif(DEFINED ENV{GITHUB_RUN_ID})
        if(DEFINED ENV{GITHUB_RUN_ATTEMPT})
            set(_identity_attempt "$ENV{GITHUB_RUN_ATTEMPT}")
        else()
            set(_identity_attempt "1")
        endif()
        set(_identity_default "$ENV{GITHUB_RUN_ID}.${_identity_attempt}")
    else()
        set(_identity_default "1")
    endif()
    set(${_identity_variable} "${_identity_default}" CACHE STRING "Frozen package build number")
endif()
set(PROTOCODUS_BUILD_NUMBER "${${_identity_variable}}")
if(NOT PROTOCODUS_BUILD_NUMBER MATCHES "^[1-9][0-9]*(\\.[1-9][0-9]*)?$")
    message(FATAL_ERROR "${_identity_variable} must be a positive integer or run.attempt pair")
endif()
execute_process(COMMAND git -C "${CMAKE_CURRENT_SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE PROTOCODUS_SOURCE_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT PROTOCODUS_SOURCE_REVISION)
    set(PROTOCODUS_SOURCE_REVISION "unversioned")
endif()
execute_process(COMMAND git -C "${CMAKE_CURRENT_SOURCE_DIR}" status --porcelain --untracked-files=no
    OUTPUT_VARIABLE _identity_dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(_identity_dirty)
    set(PROTOCODUS_SOURCE_DIRTY true)
else()
    set(PROTOCODUS_SOURCE_DIRTY false)
endif()
set(PROTOCODUS_BINARY_IDENTITY "PROTOCODUS_BUILD_IDENTITY=${PROJECT_NAME}|${PROJECT_VERSION}|${PROTOCODUS_BUILD_NUMBER}|${PROTOCODUS_SOURCE_REVISION}")
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/BuildIdentity.cpp.in"
    "${CMAKE_CURRENT_BINARY_DIR}/BuildIdentity.cpp" @ONLY)
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/build-release.json.in"
    "${CMAKE_CURRENT_BINARY_DIR}/build-release.json" @ONLY)
